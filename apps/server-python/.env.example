# Pluto Python Server Environment

# Supabase/Postgres
# Current backend uses direct Postgres via psycopg (required now).
# For Supabase, set this to your Supabase Postgres connection string.
DATABASE_URL=postgresql://pluto:pluto@localhost:5432/pluto

# Supabase Auth/API (not used by server code yet; reserve for upcoming auth integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Neo4j
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=

# Server
PORT=3000
PYTHON_ENV=development
